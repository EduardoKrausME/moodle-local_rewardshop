{{!
    @template local_rewardshop/manage

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="local-rewardshop"><p><a class="btn btn-primary" href="{{{newurl}}}">{{#str}}
    newreward,local_rewardshop{{/str}}</a> <a class="btn btn-secondary" href="{{{purchasesurl}}}">{{#str}}
    purchases,local_rewardshop{{/str}}</a> <a class="btn btn-secondary" href="{{{rulesurl}}}">{{#str}}
    creditrules,local_rewardshop{{/str}}</a></p>
    <div class="table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th>{{#str}}name{{/str}}</th>
                <th>{{#str}}rewardtype,local_rewardshop{{/str}}</th>
                <th>{{#str}}cost,local_rewardshop{{/str}}</th>
                <th>{{#str}}enabled,local_rewardshop{{/str}}</th>
                <th>{{#str}}actions{{/str}}</th>
            </tr>
            </thead>
            <tbody>{{#rewards}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{type}}</td>
                    <td>{{cost}}</td>
                    <td>{{#enabled}}{{#str}}yes{{/str}}{{/enabled}}{{^enabled}}{{#str}}no{{/str}}{{/enabled}}</td>
                    <td><a href="{{{editurl}}}">{{#str}}edit{{/str}}</a> · <a href="{{{toggleurl}}}">{{#str}}
                        toggle,local_rewardshop{{/str}}</a> · <a href="{{{duplicateurl}}}">{{#str}}
                        duplicate,local_rewardshop{{/str}}</a> · <a href="{{{upurl}}}">↑</a> <a
                            href="{{{downurl}}}">↓</a></td>
                </tr>{{/rewards}}</tbody>
        </table>
    </div>
</div>
