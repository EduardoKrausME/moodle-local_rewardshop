<div class="local-rewardshop"><div class="rewardshop-wallet"><span>{{#str}}balance,local_rewardshop{{/str}}</span><strong>{{balance}} {{#str}}credits,local_rewardshop{{/str}}</strong></div><p><a class="btn btn-secondary" href="{{{shopurl}}}">{{#str}}backtoshop,local_rewardshop{{/str}}</a></p><h3>{{#str}}purchases,local_rewardshop{{/str}}</h3><div class="table-responsive"><table class="table"><thead><tr><th>{{#str}}date{{/str}}</th><th>{{#str}}reward,local_rewardshop{{/str}}</th><th>{{#str}}cost,local_rewardshop{{/str}}</th><th>{{#str}}status{{/str}}</th></tr></thead><tbody>{{#purchases}}<tr><td>{{date}}</td><td>{{name}}{{#hint}}<div class="alert alert-light mt-2">{{hint}}</div>{{/hint}}</td><td>{{cost}}</td><td>{{status}}</td></tr>{{/purchases}}</tbody></table></div><h3>{{#str}}credithistory,local_rewardshop{{/str}}</h3><div class="table-responsive"><table class="table"><thead><tr><th>{{#str}}date{{/str}}</th><th>{{#str}}description{{/str}}</th><th>{{#str}}amount,local_rewardshop{{/str}}</th><th>{{#str}}balance,local_rewardshop{{/str}}</th></tr></thead><tbody>{{#ledger}}<tr><td>{{date}}</td><td>{{description}}</td><td>{{amount}}</td><td>{{balance}}</td></tr>{{/ledger}}</tbody></table></div></div>
