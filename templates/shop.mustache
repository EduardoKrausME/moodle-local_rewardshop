<div class="local-rewardshop"><div class="rewardshop-wallet"><span>{{#str}}balance,local_rewardshop{{/str}}</span><strong>{{balance}} {{#str}}credits,local_rewardshop{{/str}}</strong></div><div class="rewardshop-actions"><a class="btn btn-secondary" href="{{{myurl}}}">{{#str}}myhistory,local_rewardshop{{/str}}</a>{{#manageurl}}<a class="btn btn-secondary" href="{{{manageurl}}}">{{#str}}manage,local_rewardshop{{/str}}</a>{{/manageurl}}</div><div class="rewardshop-grid">{{#rewards}}<article class="reward-card">{{#image}}<img src="{{{image}}}" alt="">{{/image}}<div class="reward-card-body"><h3>{{name}}</h3><div class="reward-description">{{{description}}}</div><div class="reward-meta"><div><strong>{{cost}} {{#str}}credits,local_rewardshop{{/str}}</strong>{{#hasremaining}}<div class="small text-muted">{{#str}}remaining,local_rewardshop{{/str}}: {{remaining}}</div>{{/hasremaining}}</div><div class="reward-badges">{{#automatic}}<span class="badge badge-success">{{#str}}automatic,local_rewardshop{{/str}}</span>{{/automatic}}{{#approval}}<span class="badge badge-warning">{{#str}}approvalrequired,local_rewardshop{{/str}}</span>{{/approval}}{{#once}}<span class="badge badge-info">{{#str}}onceonly,local_rewardshop{{/str}}</span>{{/once}}</div></div>{{#available}}<form action="{{{buyurl}}}" method="post" class="reward-buy"><input type="hidden" name="rewardid" value="{{id}}"><input type="hidden" name="token" value="{{token}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="btn btn-primary" type="submit">{{#str}}buy,local_rewardshop{{/str}}</button></form>{{/available}}{{^available}}<div class="text-muted">{{reason}}</div>{{/available}}</div></article>{{/rewards}}{{^rewards}}<div class="alert alert-info">{{#str}}norewards,local_rewardshop{{/str}}</div>{{/rewards}}</div></div>
