{{!
    @template local_rewardshop/adjust
    Example context (json):
    {"courseid": 2, "sesskey": "abc", "token": "abc", "backurl": "/"}
}}
<div class="local-rewardshop">
    <form method="post" action="">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="token" value="{{token}}">
        <div class="form-group">
            <label for="rewardshop-adjust-user">{{#str}}adjustuserid,local_rewardshop{{/str}}</label>
            <input id="rewardshop-adjust-user" class="form-control" type="number" name="userid" min="1" required>
        </div>
        <div class="form-group">
            <label for="rewardshop-adjust-amount">{{#str}}adjustamount,local_rewardshop{{/str}}</label>
            <input id="rewardshop-adjust-amount" class="form-control" type="number" name="amount" required>
        </div>
        <div class="form-group">
            <label for="rewardshop-adjust-reason">{{#str}}adjustreason,local_rewardshop{{/str}}</label>
            <textarea id="rewardshop-adjust-reason" class="form-control" name="reason" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">{{#str}}savechanges{{/str}}</button>
        <a href="{{{backurl}}}" class="btn btn-secondary">{{#str}}cancel{{/str}}</a>
    </form>
</div>
