<div class="local-rewardshop"><p><a class="btn btn-secondary" href="{{manageurl}}">{{#str}}back{{/str}}</a></p><div class="table-responsive"><table class="table"><thead><tr><th>{{#str}}date{{/str}}</th><th>{{#str}}user{{/str}}</th><th>{{#str}}reward,local_rewardshop{{/str}}</th><th>{{#str}}cost,local_rewardshop{{/str}}</th><th>{{#str}}status{{/str}}</th><th>{{#str}}actions{{/str}}</th></tr></thead><tbody>{{#rows}}<tr><td>{{date}}</td><td>{{user}}</td><td>{{reward}}</td><td>{{cost}}</td><td>{{status}}</td><td>{{#pending}}<a class="btn btn-sm btn-success" href="{{approveurl}}">{{#str}}approve,local_rewardshop{{/str}}</a> <a class="btn btn-sm btn-danger" href="{{rejecturl}}">{{#str}}reject,local_rewardshop{{/str}}</a>{{/pending}}{{#approved}}<a class="btn btn-sm btn-secondary" href="{{deliverurl}}">{{#str}}markdelivered,local_rewardshop{{/str}}</a>{{/approved}}{{#canrefund}} <a class="btn btn-sm btn-outline-danger" href="{{refundurl}}">{{#str}}refund,local_rewardshop{{/str}}</a>{{/canrefund}}</td></tr>{{/rows}}</tbody></table></div></div>
